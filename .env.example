# Copy to .env and fill in. .env is gitignored; never commit it.
# The judge runs over an API. Targets run locally (llama.cpp / Ollama), no key needed.

# --- Option A: OpenAI ---
JUDGE_MODEL=gpt-4o
OPENAI_API_KEY=replace-me

# --- Option B: any OpenAI-compatible provider ---
# JUDGE_MODEL=
# JUDGE_BASE_URL=
# JUDGE_API_KEY=

# --- Option C: local judge via Ollama ---
# JUDGE_MODEL=llama3.2
# JUDGE_BASE_URL=http://localhost:11434/v1
# JUDGE_API_KEY=ollama
